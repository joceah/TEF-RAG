      "estimate_doc_create_date": "2026-08-03T08:00:00Z"
    }
  },
  {
    "corpus_uid": "doc-3c624fba691ba80ac5a9a785",
    "chunk_number": 0,
    "chunk_text": "TEFV5H-04，WO-C118：对静态开关晶闸管、触发板及门极驱动电路进行点检。晶闸管正向压降0.82V，反向漏电流小于1mA，触发脉冲幅值4.8V，均在合格范围内。器件与触发点检未发现硬件故障证据，硬件故障解释减弱。",
    "chunk_time_info": [
      {
        "event_time_interval": {
          "begin": "2026-08-04T08:00:00Z",
          "end": "2026-08-04T08:00:01Z"
