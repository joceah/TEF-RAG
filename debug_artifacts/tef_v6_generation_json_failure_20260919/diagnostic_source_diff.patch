+    def _diagnostic_excerpt(text: str, position: int | None = None) -> dict[str, Any]:
+        excerpt: dict[str, Any] = {
+            "first_300": text[:300],
+            "last_300": text[-300:] if text else "",
+        }
+        if position is not None:
+            start = max(0, position - 200)
